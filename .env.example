# Copy to .env locally. Never commit .env.
# The app runs in demo mode with no cloud values set.

# Core
SECRET_KEY=change-me-in-production
DEMO_MODE=true
DEMO_DB_PATH=instance/demo.db
PORT=8080

# Google Cloud
PROJECT_ID=
PROJECT_NUMBER=
REGION=us-central1
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
MODEL=gemini-2.5-flash

# AlloyDB (leave blank for SQLite demo mode)
ALLOYDB_DSN=
ALLOYDB_HOST=
ALLOYDB_PORT=5432
ALLOYDB_CLUSTER=ecommerce-cluster
ALLOYDB_INSTANCE=ecommerce-cluster-primary
ALLOYDB_DATABASE=postgres
ALLOYDB_USER=postgres
ALLOYDB_PASSWORD=
BUCKET=

# MongoDB Atlas (leave blank for SQLite demo mode)
MONGODB_URI=
MONGODB_DB=ecommerce_db

# BigQuery (leave blank to use the demo interaction store)
BIGQUERY_PROJECT=
BIGQUERY_DATASET=ecommerce_analytics
BIGQUERY_TABLE=user_product_interactions

# MCP Toolbox
MCP_TOOLBOX_URL=
REASONING_ENGINE_LOCATION=us-central1
APP_NAME=
